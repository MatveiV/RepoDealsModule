# REPO Module Environment Variables
# Copy to .env and fill in values

# Mode: demo or production
MODE=demo

# Production DB (only needed in production mode)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=repo_module
DB_USER=repo_user
DB_PASSWORD=changeme

# SFTP (only needed in production mode)
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=repo_sftp
SFTP_KEY_PATH=/app/keys/sftp_key
SFTP_REMOTE_DIR=/repo/incoming

# S3 (alternative to SFTP, only in production mode)
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=repo-incoming
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Kafka (only needed in production mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# API
API_HOST=0.0.0.0
API_PORT=8000

# SQLite path (demo mode only)
SQLITE_PATH=repo_module.db
