    style END fill:#1F4E79,color:#fff,stroke:#1F4E79
    style CRIT1 fill:#FFEBEE,stroke:#C62828,color:#B71C1C
    style ALERT_INCONS fill:#FFF9C4,stroke:#F57F17,color:#E65100
    style ALERT_BATCH fill:#FFF9C4,stroke:#F57F17,color:#E65100
    style MVP_DEFAULT fill:#E8F4FD,stroke:#1565C0,color:#0D47A1
